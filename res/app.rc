#include <winver.h>
#include "../build/version.h"

// App icon by nik-txt (app.svg, made by make_icon.py): white for the exe and dark themes, black for light ones.
1 ICON "app.ico"
2 ICON "app_light.ico"
1 24 "app.manifest"
FLAG_RU BITMAP "flag_ru.bmp"  // Russian flag next to Русский in the Language menu (PR #1754)

// The built-in UI languages: lang\*.txt joined by the build (see src/i18n.cpp).
LANGS RCDATA "languages.txt"


VS_VERSION_INFO VERSIONINFO
FILEVERSION WB_VERSION_RESOURCE
PRODUCTVERSION WB_VERSION_RESOURCE
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Kjerne"
      VALUE "FileDescription", "KJ-BatteryHub"
      VALUE "ProductName", "KJ-BatteryHub"
      VALUE "FileVersion", WB_VERSION_STRING
      VALUE "ProductVersion", WB_VERSION_STRING
      VALUE "OriginalFilename", "KJ-BatteryHub.exe"
      VALUE "LegalCopyright", "KJ-BatteryHub by Kjerne, a fork of BatteryHub by krisgfx9 and contributors. GNU GPL v3."
      VALUE "Comments", "https://github.com/Kjerne/KJ-BatteryHub"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
